#!/usr/bin/env python3
"""tectdist — a standard-TeX-compatible distribution backed by Tectonic.

This is a thin launcher: all logic lives in the tectdist package under
src/tectdist/.  Every other binary name in bin/ is a symlink to this file;
the dispatcher switches on the invoked name (argv[0] basename), so bare
`pdflatex`, `latexmk`, `kpsewhich`, ... behave like a stock TeX Live.

For release, `python3 build.py` compiles a single self-contained executable
(dist/tectdist) via zipapp; install that instead of this source tree.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_src = os.path.join(os.path.dirname(_here), "src")
if os.path.isdir(_src) and _src not in sys.path:
    sys.path.insert(0, _src)

try:
    from tectdist.dispatcher import main
except ImportError:
    print("tectdist: cannot find the tectdist package (src/tectdist).",
          file=sys.stderr)
    print("Use the built artifact (dist/tectdist) for installation.",
          file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
