{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tectdist paired benchmark result bundle",
  "type": "object",
  "required": ["schema_version", "session_id", "timestamp_utc", "platform", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_commit": {"type": "string"},
    "dirty": {"type": "boolean"},
    "runner_commit": {"type": "string"},
    "qualification": {"type": "boolean"},
    "trial_class": {"enum": ["ordinary", "expensive"]},
    "session_id": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "platform": {"type": "object"},
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "document", "scenario", "samples", "summary"],
      "properties": {
        "tool": {"type": "object"},
        "document": {"type": "string"},
        "scenario": {"type": "string"},
        "cold_source": {"enum": ["controlled-local", "public-network", "not-applicable"]},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "pair": {
      "type": "object",
      "required": ["order", "tools"],
      "properties": {
        "order": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "tools": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/$defs/sample"}}
      }
    },
    "sample": {
      "type": "object",
      "required": ["wall_time_ms", "exit_status", "process_count", "process_count_method", "engine_pass_count", "external_tool_count", "correctness", "trace_spans", "resources"],
      "properties": {
        "wall_time_ms": {"type": "number", "minimum": 0},
        "user_cpu_ms": {"type": "number", "minimum": 0},
        "system_cpu_ms": {"type": "number", "minimum": 0},
        "peak_rss": {"type": "number", "minimum": 0},
        "exit_status": {"type": "integer"},
        "process_count": {"type": "integer", "minimum": 1},
        "process_count_method": {"enum": ["trace-estimate", "root-process-lower-bound"]},
        "engine_pass_count": {"type": "integer", "minimum": 0},
        "external_tool_count": {"type": "integer", "minimum": 0},
        "trace_spans": {"type": "array"},
        "resources": {
          "type": "object",
          "required": ["download_observed", "bytes_downloaded", "download_duration_ms", "decompression_duration_ms", "measurement"],
          "properties": {
            "download_observed": {"type": "boolean"},
            "bytes_downloaded": {"type": ["integer", "null"], "minimum": 0},
            "download_duration_ms": {"type": "number", "minimum": 0},
            "decompression_duration_ms": {"type": "number", "minimum": 0},
            "measurement": {"enum": ["trace-and-explicit-counter", "cache-growth-estimate", "unavailable"]}
          }
        },
        "correctness": {"type": "object", "required": ["ok", "errors"]},
        "output_sha256": {"type": "string"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "median_difference_ms": {"type": "number"},
        "mean_difference_ms": {"type": "number"},
        "ci95_ms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      }
    }
  }
}
